--==================================================
-- VISUAL DO INTERRUPTOR
--==================================================

local function atualizarVisual()
	if AUTO_GRAB_ATIVO then
		switch.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
		status.Text = "ATIVADO"
		status.TextColor3 = Color3.fromRGB(80, 220, 120)

		TweenService:Create(
			bola,
			TweenInfo.new(0.15),
			{
				Position = UDim2.new(1, -31, 0.5, -14)
			}
		):Play()
	else
		switch.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
		status.Text = "DESATIVADO"
		status.TextColor3 = Color3.fromRGB(220, 220, 220)

		TweenService:Create(
			bola,
			TweenInfo.new(0.15),
			{
				Position = UDim2.new(0, 3, 0.5, -14)
			}
		):Play()
	end
end

--==================================================
-- ATIVAR / DESATIVAR
--==================================================

switch.MouseButton1Click:Connect(function()
	AUTO_GRAB_ATIVO = not AUTO_GRAB_ATIVO

	for prompt, _ in pairs(duracoesOriginais) do
		if prompt and prompt.Parent then
			configurarPrompt(prompt)
		end
	end

	atualizarVisual()
end)

--==================================================
-- ARRASTAR A GUI
--==================================================

local dragging = false
local dragStart
local startPosition
local dragInput

local function atualizarPosicao(input)
	local delta = input.Position - dragStart

	frame.Position = UDim2.new(
		startPosition.X.Scale,
		startPosition.X.Offset + delta.X,
		startPosition.Y.Scale,
		startPosition.Y.Offset + delta.Y
	)
end

-- Começa a arrastar
frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = frame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

-- Detecta movimento
frame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input == dragInput then
		atualizarPosicao(input)
	end
end)

--==================================================
-- INICIAR
--==================================================

atualizarVisual()
