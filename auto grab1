--==================================================
-- ATUALIZAR VISUAL
--==================================================

local function atualizarVisual()
	if AUTO_GRAB_ATIVO then
		switch.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
		status.Text = "ATIVADO"
		status.TextColor3 = Color3.fromRGB(80, 220, 120)

		TweenService:Create(
			bola,
			TweenInfo.new(0.15),
			{
				Position = UDim2.new(1, -31, 0.5, -14)
			}
		):Play()
	else
		switch.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
		status.Text = "DESATIVADO"
		status.TextColor3 = Color3.fromRGB(220, 220, 220)

		TweenService:Create(
			bola,
			TweenInfo.new(0.15),
			{
				Position = UDim2.new(0, 3, 0.5, -14)
			}
		):Play()
	end
end

--==================================================
-- CLICAR NO INTERRUPTOR
--==================================================

switch.MouseButton1Click:Connect(function()
	AUTO_GRAB_ATIVO = not AUTO_GRAB_ATIVO

	-- Aplica a mudança em todos os prompts
	for prompt, _ in pairs(duracoesOriginais) do
		if prompt and prompt.Parent then
			configurarPrompt(prompt)
		end
	end

	atualizarVisual()
end)

atualizarVisual()
