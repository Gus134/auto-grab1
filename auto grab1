--==================================================
-- CONFIGURAÇÕES
--==================================================

local AUTO_GRAB_ATIVO = true
local duracoesOriginais = {}

--==================================================
-- AUTO GRAB
--==================================================

local function configurarPrompt(prompt)
	if not prompt:IsA("ProximityPrompt") then
		return
	end

	if duracoesOriginais[prompt] == nil then
		duracoesOriginais[prompt] = prompt.HoldDuration
	end

	if AUTO_GRAB_ATIVO then
		prompt.HoldDuration = 0
	else
		prompt.HoldDuration = duracoesOriginais[prompt]
	end
end

for _, objeto in ipairs(workspace:GetDescendants()) do
	configurarPrompt(objeto)
end

workspace.DescendantAdded:Connect(function(objeto)
	if objeto:IsA("ProximityPrompt") then
		task.wait()
		configurarPrompt(objeto)
	end
end)

